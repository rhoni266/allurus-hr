rules_version = '2';
// Who may read and write what in the Allurus cloud database. Publish in Firebase console → Firestore → Rules,
// or with `firebase deploy --only firestore:rules`. The bucket classes must match js/cloud-map.js.
//
//   users/{uid}            Each person's link to their company: tenantId, roles, empId.
//   invites/{email}        HR's invitation for a work email. Joining needs that email, confirmed.
//   tenants/{t}            The company. Members read; admins update.
//     buckets/{id}         Shared records. Field r says who reads: 'm' every member, 'a' any Company Admin,
//                          'p' admins with the payroll area, 'f' admins with the finance area, 'o' admins with
//                          the operations area, 'd:<empId>' that driver's deliveries (ops.dos~<empId>), read and
//                          updated by the driver and admins with the operations area. Breakdowns
//                          (ops.breakdowns) are read by every member; without the operations area a member may
//                          only add a report, not change or remove one.
//     people/{empId}       Full employee record: admins with the people or payroll area, and the person (who may
//                          change only their phones and face).
//     payslips/{empId}     Admins with the payroll area write and read; the person reads their own.
//
// Company Admins have role templates: a `perms` list of areas (people, time, payroll, claims, finance, talent,
// operations, settings) on their profile. No list means every area (Owner). Nobody can give access they don't have.
//     personal/{empId}     The person's own financial plan and tax reliefs. Only them.
//     blobs/{id}           Photos and files. Members read and add; nobody overwrites.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userDoc()); }
    function me() { return get(userDoc()).data; }
    // A disabled person (users/{uid}.disabled, set by an admin) is no longer a member: blocked at once.
    function member(t) { return hasProfile() && me().tenantId == t && me().get('disabled', false) != true; }
    function admin(t) { return member(t) && ('admin' in me().roles); }
    function myEmail() { return request.auth.token.email.lower(); }

    // ---- Industries and features (allurus.my/superadmin) ----
    // Superadmin comes only from the Firebase custom claim role == 'superadmin' (scripts/set-superadmin.js), never
    // from a field a browser can write.
    function isSuperadmin() { return request.auth != null && request.auth.token.role == 'superadmin'; }
    function auditDoc(id) { return /databases/$(database)/documents/auditLog/$(id); }
    // Every superadmin change carries lastAuditId: the audit entry written in the same batch, about this very
    // document. Without it the write is refused, so nothing changes without a record of who, what and when.
    function audited(entityType, id) {
      // The entry must be new in this same batch: an older entry left on the document doesn't count again.
      return isSuperadmin() && request.resource.data.lastAuditId is string
        && !exists(auditDoc(request.resource.data.lastAuditId))
        && existsAfter(auditDoc(request.resource.data.lastAuditId))
        && getAfter(auditDoc(request.resource.data.lastAuditId)).data.entityType == entityType
        && getAfter(auditDoc(request.resource.data.lastAuditId)).data.entityId == id
        && getAfter(auditDoc(request.resource.data.lastAuditId)).data.actorUid == request.auth.uid;
    }
    function shortText(v, n) { return v is string && v.size() <= n; }
    function verified() { return request.auth.token.email_verified == true; }
    function inviteFor(email) { return get(/databases/$(database)/documents/invites/$(email)).data; }

    // ---- Trials and subscriptions (the same logic as js/billing-rules.js) ----
    // The status is worked out from the dates at every request, so a trial ends on time without a daily job.
    // Companies from before billing have no status and count as active.
    function co(t) { return get(/databases/$(database)/documents/tenants/$(t)).data; }
    function coStatus(d) { return d.get('status', 'active'); }
    function coExpired(d) {
      return coStatus(d) == 'expired'
        || (coStatus(d) == 'trial' && d.get('trialEndsAt', null) is timestamp && d.trialEndsAt < request.time)
        || (coStatus(d) in ['active', 'past_due'] && d.get('paidUntil', null) is timestamp && d.paidUntil + duration.value(7, 'd') < request.time);
    }
    // Normal use: trial, active, past due (in its grace period).
    function working(t) { return !(coStatus(co(t)) in ['suspended', 'cancelled']) && !coExpired(co(t)); }
    // Expired or cancelled: the company's admins may still read everything (to export) and pay; staff can't.
    function canRead(t) { return working(t) || (admin(t) && (coExpired(co(t)) || coStatus(co(t)) == 'cancelled')); }
    function disposable(email) {
      return email.split('@')[1] in ['mailinator.com', 'guerrillamail.com', 'guerrillamail.info', 'sharklasers.com', '10minutemail.com', 'tempmail.com',
        'temp-mail.org', 'yopmail.com', 'trashmail.com', 'getnada.com', 'dispostable.com', 'maildrop.cc', 'mailnesia.com', 'throwawaymail.com',
        'fakeinbox.com', 'mintemail.com', 'emailondeck.com', 'mohmal.com', 'tempail.com', 'moakt.com'];
    }
    function tenantPath(t) { return /databases/$(database)/documents/tenants/$(t); }

    // Areas of the company console (see AREAS in js/app.js and js/cloud-map.js).
    function owner() { return !('perms' in me()); }
    function hasArea(t, a) { return admin(t) && (owner() || a in me().perms); }
    function seesPeople(t) { return hasArea(t, 'people') || hasArea(t, 'payroll'); }
    function isFinance(b) { return b == 'finance' || b.matches('finance[.].*'); }
    function isOps(b) { return b == 'ops' || b.matches('ops[.].*'); }
    function isDriverBucket(b) { return b.matches('ops[.]dos~.+'); }
    function driverOf(b) { return b.split('~')[1]; }
    function opsShared(b) { return b in ['ops.machines', 'ops.products', 'ops.breakdowns']; }
    function bucketClass(b) {
      return b in ['payroll', 'payChanges', 'loans', 'insurance'] ? 'p' : (isFinance(b) ? 'f' : (b in ['savedReports', 'importData'] ? 'a'
        : (isDriverBucket(b) ? 'd:' + driverOf(b) : (isOps(b) && !opsShared(b) ? 'o' : 'm'))));
    }
    function readsClass(t, r) {
      return r == 'm' || (r == 'a' && admin(t)) || (r == 'p' && hasArea(t, 'payroll')) || (r == 'f' && hasArea(t, 'finance'))
        || (r == 'o' && hasArea(t, 'operations'))
        // A driver's deliveries. Written as a range (not a pattern) so the operations admins' query on 'd:'…'d;' passes.
        || (r >= 'd:' && r < 'd;' && (hasArea(t, 'operations') || (member(t) && r == 'd:' + me().empId)));
    }
    function bucketArea(b) {
      return b in ['payroll', 'payChanges', 'loans', 'insurance', 'statutory'] ? 'payroll'
        : (isFinance(b) ? 'finance' : (b == 'settings' ? 'settings' : (b in ['departments', 'directory', 'importData'] ? 'people'
        : (b == 'cycles' ? 'talent' : (b == 'savedReports' ? 'admin' : (isOps(b) && b != 'ops.breakdowns' ? 'operations' : ''))))));
    }
    // A breakdown report added by someone without the operations area: new records only, nothing changed or removed.
    function onlyAdds() {
      return resource == null || (request.resource.data.f.diff(resource.data.f).changedKeys().hasOnly(['~ord'])
        && request.resource.data.f.diff(resource.data.f).removedKeys().size() == 0);
    }
    function writesBucket(t, b) {
      return (isDriverBucket(b) && member(t) && driverOf(b) == me().empId)
        || (b == 'ops.breakdowns' && (hasArea(t, 'operations') || (member(t) && onlyAdds())))
        || (b != 'ops.breakdowns' && (bucketArea(b) == '' ? member(t) : (bucketArea(b) == 'admin' ? admin(t) : hasArea(t, bucketArea(b)))));
    }
    // Access d (an invite or profile) gives no more than the giver has: an Owner may give anything; anyone else only
    // a list of their own areas, never Owner (an admin with no list).
    function grantable(d) { return !('admin' in d.roles) || owner() || ('perms' in d && d.perms.hasOnly(me().perms)); }
    function validRoles(d) { return d.roles in [['employee'], ['admin', 'employee']] && (!('perms' in d) || d.perms is list); }
    function samePerms(d, inv) { return ('perms' in inv) ? ('perms' in d && d.perms == inv.perms) : !('perms' in d); }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || hasArea(resource.data.tenantId, 'settings'));
      allow list: if hasProfile() && resource.data.tenantId == me().tenantId && hasArea(me().tenantId, 'settings');
      allow read: if isSuperadmin();
      // The only way into a company: activating an admin's invitation (allurus.my/activate) with that email
      // confirmed, before the invitation expires. Company, roles, areas and employee come from the invitation,
      // never from the browser. Nobody signs a company up themselves; the superadmin creates companies.
      allow create: if signedIn() && request.auth.uid == uid && !hasProfile()
        && request.resource.data.email == myEmail() && verified()
        && !('disabled' in request.resource.data)
        && (
          (exists(/databases/$(database)/documents/invites/$(myEmail()))
            && inviteFor(myEmail()).expiresAt is timestamp && inviteFor(myEmail()).expiresAt > request.time
            && inviteFor(myEmail()).tenantId == request.resource.data.tenantId
            && inviteFor(myEmail()).roles == request.resource.data.roles
            && inviteFor(myEmail()).empId == request.resource.data.empId
            && samePerms(request.resource.data, inviteFor(myEmail())))
          // ...or the founder of a company signing itself up now (allurus.my/signup), in the same batch: its Owner.
          || (!exists(tenantPath(request.resource.data.tenantId)) && existsAfter(tenantPath(request.resource.data.tenantId))
            && getAfter(tenantPath(request.resource.data.tenantId)).data.owner == uid
            && getAfter(tenantPath(request.resource.data.tenantId)).data.createdVia == 'self_signup'
            && request.resource.data.roles == ['admin', 'employee'] && request.resource.data.empId == 'e1' && !('perms' in request.resource.data))
        );
      // Admins with the settings area change someone else's access in their company, or disable them; nobody
      // changes their own.
      allow update: if signedIn() && request.auth.uid != uid && hasArea(resource.data.tenantId, 'settings')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'perms', 'disabled', 'posRole'])
        && request.resource.data.get('posRole', '') in ['', 'manager', 'cashier', 'waiter', 'kitchen']
        && request.resource.data.get('disabled', false) is bool
        && validRoles(request.resource.data) && grantable(request.resource.data) && grantable(resource.data);
      allow delete: if signedIn() && request.auth.uid != uid && hasArea(resource.data.tenantId, 'settings') && grantable(resource.data);
    }

    match /invites/{email} {
      allow get: if signedIn() && (myEmail() == email || hasArea(resource.data.tenantId, 'settings'));
      allow list: if hasProfile() && resource.data.tenantId == me().tenantId && hasArea(me().tenantId, 'settings');
      // An invitation lasts at most 8 days (the app gives 7); resending writes a new expiry.
      allow create, update: if email == email.lower() && hasArea(request.resource.data.tenantId, 'settings')
        && validRoles(request.resource.data) && grantable(request.resource.data) && validExpiry();
      allow delete: if hasArea(resource.data.tenantId, 'settings');
      // The superadmin invites a new company's first admin (an Owner: every area), and sees every invitation.
      allow read: if isSuperadmin();
      allow create, update: if isSuperadmin() && email == email.lower() && request.resource.data.roles == ['admin', 'employee']
        && request.resource.data.empId == 'e1' && !('perms' in request.resource.data) && validExpiry()
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId));
    }
    function validExpiry() {
      return request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
    }

    // Enquiries from the contact form on allurus.my: anyone may add one with these fields only; nobody can read,
    // change or delete them from a browser. They are read in the Firebase console.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','company','email','phone','staff','message','at'])
        && request.resource.data.name is string && request.resource.data.name.size() < 100
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() < 2000));
      allow read, update, delete: if false;
    }

    // Catalogue: the public site reads it; only an audited superadmin change writes it. Nothing is ever deleted:
    // archive (archived: true), unlink (linked: false) and clear an override (mode: 'none') instead.
    match /modules/{id} {
      allow read: if true;
      allow create, update: if audited('module', id);
    }
    match /features/{id} {
      allow read: if true;
      allow create, update: if audited('feature', id);
    }
    match /industries/{id} {
      // The public page lists with where('visible', '==', true); hidden ones are for superadmin only.
      allow read: if resource.data.visible == true || isSuperadmin();
      allow create, update: if audited('industry', id) && request.resource.data.slug == id;
    }
    match /industryFeatures/{id} {
      allow read: if true;
      allow create, update: if audited('industryFeature', id) && id == request.resource.data.industryId + '_' + request.resource.data.featureId;
    }
    match /finderRules/{id} {
      allow read: if true;
      allow create, update: if audited('finderRule', id);
    }
    // Per-company switches on top of the industry: read by that company's members (the app uses them) and superadmin.
    match /tenantFeatureOverrides/{id} {
      allow read: if isSuperadmin() || member(resource.data.tenantId);
      allow create, update: if audited('tenantOverride', id) && request.resource.data.mode in ['add', 'remove', 'none']
        && id == request.resource.data.tenantId + '_' + request.resource.data.featureId;
    }
    // "Tell us you need this" leads from allurus.my. Anyone may add one (fixed fields, sensible sizes, consent given,
    // status 'new', timestamped now); only superadmin reads them or moves them along. Never deleted.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['businessName', 'contactName', 'phone', 'email', 'industryIds', 'otherIndustry',
            'featureInterests', 'teamSize', 'notes', 'consent', 'status', 'lang', 'createdAt'])
        && shortText(request.resource.data.businessName, 150) && request.resource.data.businessName.size() > 0
        && shortText(request.resource.data.contactName, 100) && request.resource.data.contactName.size() > 0
        && shortText(request.resource.data.phone, 30) && request.resource.data.phone.size() >= 9
        && (!('email' in request.resource.data) || shortText(request.resource.data.email, 200))
        && request.resource.data.industryIds is list && request.resource.data.industryIds.size() <= 12
        && (!('otherIndustry' in request.resource.data) || shortText(request.resource.data.otherIndustry, 200))
        && (!('featureInterests' in request.resource.data) || (request.resource.data.featureInterests is list && request.resource.data.featureInterests.size() <= 60))
        && (!('teamSize' in request.resource.data) || shortText(request.resource.data.teamSize, 40))
        && (!('notes' in request.resource.data) || shortText(request.resource.data.notes, 2000))
        && (!('lang' in request.resource.data) || shortText(request.resource.data.lang, 5))
        && request.resource.data.consent == true && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(10, 'm') && request.resource.data.createdAt < request.time + duration.value(10, 'm');
      allow read: if isSuperadmin();
      allow update: if audited('lead', id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedTo', 'lastAuditId'])
        && request.resource.data.status in ['new', 'contacted', 'demo', 'won', 'lost'];
    }
    // Who changed what and when. Superadmin adds entries (as themselves, timestamped by the server); nobody edits or
    // deletes them.
    match /auditLog/{id} {
      allow read: if isSuperadmin();
      allow create: if isSuperadmin() && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'entityType', 'entityId', 'before', 'after', 'createdAt'])
        && request.resource.data.entityType in ['module', 'feature', 'industry', 'industryFeature', 'finderRule', 'tenant', 'tenantOverride', 'lead', 'plan', 'config', 'payment', 'invoice'];
      allow update, delete: if false;
    }

    // ---- Sign-up and billing ----
    // One free trial per mobile number: a record named by the number's SHA-256, created once with the company and
    // never read, changed or removed from a browser (the number itself isn't stored here).
    match /signupAttempts/{h} {
      allow create: if signedIn() && verified() && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time;
    }
    // Plans and prices: anyone may read them (the pricing and billing pages); only the superadmin edits them.
    match /plans/{id} {
      allow read: if true;
      allow write: if audited('plan', id);
    }
    // Billing settings (bank and DuitNow details) and the invoice counter.
    match /config/{id} {
      allow read: if signedIn();
      allow write: if audited('config', id);
    }
    // A company admin sends proof of a bank transfer, even while expired; the superadmin approves or rejects it.
    match /payments/{id} {
      allow read: if isSuperadmin() || (signedIn() && admin(resource.data.tenantId));
      allow create: if signedIn() && admin(request.resource.data.tenantId) && !(coStatus(co(request.resource.data.tenantId)) in ['suspended'])
        && request.resource.data.keys().hasOnly(['tenantId', 'planId', 'months', 'amountMyr', 'reference', 'method', 'proof', 'proofName', 'proofType', 'status', 'submittedBy', 'createdAt'])
        && request.resource.data.status == 'submitted' && request.resource.data.submittedBy == myEmail() && request.resource.data.createdAt == request.time
        && request.resource.data.months is int && request.resource.data.months >= 1 && request.resource.data.months <= 24
        && request.resource.data.amountMyr is number && request.resource.data.amountMyr >= 0
        && shortText(request.resource.data.reference, 40) && shortText(request.resource.data.planId, 40) && shortText(request.resource.data.method, 20)
        && request.resource.data.proof is string && request.resource.data.proof.size() < 950000 && shortText(request.resource.data.proofName, 120);
      allow update: if audited('payment', id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'note', 'invoiceId', 'lastAuditId'])
        && request.resource.data.status in ['approved', 'rejected'];
    }
    match /invoices/{id} {
      allow read: if isSuperadmin() || (signedIn() && admin(resource.data.tenantId));
      allow create: if audited('invoice', id);
    }
    // The public demo (?demo, ?demo=suria, ?demo=majorfe): the check-in point its admin set, so every phone trying the
    // demo checks in against it. No sign-in, demo companies only, and only these fields with sensible values.
    match /demoZones/{co} {
      allow read: if co in ['serimaju', 'suria', 'majorfe', 'banafsha'];
      allow write: if co in ['serimaju', 'suria', 'majorfe', 'banafsha']
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'radius', 'label', 'field', 'setAt'])
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.radius is int && request.resource.data.radius >= 10 && request.resource.data.radius <= 5000
        && request.resource.data.label is string && request.resource.data.label.size() < 80
        && request.resource.data.field is list && request.resource.data.field.size() < 50
        && request.resource.data.setAt is int;
    }

    match /tenants/{t} {
      allow read: if member(t);
      // Only the superadmin opens a company (with an audit entry). It has no owner until its first admin
      // activates their invitation and claims it, once.
      allow create: if audited('tenant', t) && request.resource.data.owner == null
        && request.resource.data.keys().hasOnly(['owner', 'name', 'admin', 'adminName', 'industry', 'city', 'country', 'plan', 'seats', 'createdAt', 'inviteStatus', 'inviteSentAt',
          'status', 'isTest', 'trialStartedAt', 'trialEndsAt', 'paidUntil', 'createdVia', 'industryIds', 'lastAuditId'])
        && request.resource.data.admin is string && request.resource.data.admin == request.resource.data.admin.lower();
      // A company signing itself up (allurus.my/signup), with its confirmed email: a 30-day trial, owned by them,
      // with a mobile number never used for a trial before (signupAttempts, created in the same batch).
      allow create: if signedIn() && verified() && !hasProfile() && !disposable(myEmail())
        && request.resource.data.keys().hasOnly(['owner', 'name', 'admin', 'adminName', 'phone', 'industryIds', 'industryOther', 'staffRange', 'city', 'country',
          'status', 'plan', 'isTest', 'trialStartedAt', 'trialEndsAt', 'createdVia', 'termsVersion', 'termsAcceptedAt', 'createdAt'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.admin == myEmail()
        && request.resource.data.status == 'trial' && request.resource.data.plan == 'trial' && request.resource.data.isTest == false
        && request.resource.data.createdVia == 'self_signup'
        && request.resource.data.trialStartedAt == request.time && request.resource.data.createdAt == request.time
        && request.resource.data.trialEndsAt is timestamp && request.resource.data.trialEndsAt > request.time + duration.value(29, 'd')
        && request.resource.data.trialEndsAt < request.time + duration.value(31, 'd')
        && request.resource.data.termsAcceptedAt == request.time && shortText(request.resource.data.termsVersion, 20)
        && shortText(request.resource.data.name, 120) && request.resource.data.name.size() >= 2 && shortText(request.resource.data.adminName, 100)
        && request.resource.data.phone is string && request.resource.data.phone.matches('^601[0-9]{8,9}$')
        && existsAfter(/databases/$(database)/documents/signupAttempts/$(hashing.sha256(request.resource.data.phone).toHexString().lower()))
        && getAfter(/databases/$(database)/documents/signupAttempts/$(hashing.sha256(request.resource.data.phone).toHexString().lower())).data.uid == request.auth.uid
        && request.resource.data.industryIds is list && request.resource.data.industryIds.size() <= 5
        && (!('industryOther' in request.resource.data) || shortText(request.resource.data.industryOther, 80))
        && shortText(request.resource.data.staffRange, 20);
      allow update: if member(t) && resource.data.owner == null && myEmail() == resource.data.admin && owner() && 'admin' in me().roles
        && request.resource.data.owner == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner']);
      // The company's own admins edit its profile, never its owner, industries or billing.
      allow update: if hasArea(t, 'settings') && request.resource.data.owner == resource.data.owner && working(t)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['industryIds', 'lastAuditId', 'status', 'plan', 'isTest', 'trialStartedAt', 'trialEndsAt',
          'paidUntil', 'expiredAt', 'statusNote', 'createdVia', 'termsVersion', 'termsAcceptedAt', 'admin', 'phone']);
      // Superadmin: sees every company, and sets only which industries it belongs to (with an audit entry).
      allow read: if isSuperadmin();
      // ...and can view (never change) everything inside one, for support. Opening a company from /superadmin
      // writes an audit entry first (action view-company).
      match /{inside=**} {
        allow read: if isSuperadmin();
      }
      allow update: if audited('tenant', t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['industryIds', 'lastAuditId'])
        && request.resource.data.industryIds is list && request.resource.data.industryIds.size() <= 12;
      // ...and records whether the first admin's invitation went out ("sent" or "failed"), for Retry invite.
      allow update: if audited('tenant', t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteStatus', 'inviteSentAt', 'lastAuditId'])
        && request.resource.data.inviteStatus in ['sent', 'failed'];
      // ...and runs billing: extend a trial, mark as paid, change plan, suspend, reactivate (each audited).
      allow update: if audited('tenant', t) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'plan', 'trialEndsAt', 'paidUntil', 'expiredAt', 'statusNote', 'isTest', 'lastAuditId'])
        && request.resource.data.get('status', 'active') in ['trial', 'active', 'past_due', 'expired', 'suspended', 'cancelled'];

      // Everything inside a company also follows its status: written only while it's working; read while working,
      // or by its admins once expired or cancelled (export). Suspended: nobody.
      match /buckets/{b} {
        allow read: if member(t) && readsClass(t, resource.data.r) && canRead(t);
        allow create, update: if writesBucket(t, b) && request.resource.data.r == bucketClass(b) && working(t);
        allow delete: if writesBucket(t, b) && admin(t) && working(t);
      }

      // ---- Invoices: one document each, so a sent invoice is locked here, not only on screen ----
      // The same rules as js/invoice-rules.js. Admins with the finance area only; staff never.
      //   Draft: edited freely. Every save raises v by one, so a save from an out-of-date copy is refused
      //          ("This invoice changed. Reload."). Number, type and creator never change. Only drafts are deleted.
      //   Mark as sent: only status, sentAt and sentBy change; the lines are as last saved.
      //   Sent, part paid, paid: only payments, credit or debit note effects and the e-Invoice status change.
      //   Void: from Sent with no payments yet, with a reason; keeps its number. (Paid money: credit or refund note.)
      //   Credit, debit and refund notes are issued final; only their e-Invoice status changes later.
      // Each status change carries lastAuditId: an invoiceAudit entry about this invoice, by this person, written
      // in the same batch. Each number is held in invoiceNos, so no two invoices share one.
      match /invoices/{id} {
        function nd() { return request.resource.data; }
        function od() { return resource.data; }
        function finOk() { return hasArea(t, 'finance') && working(t); }
        function stamped() { return nd().updatedBy == request.auth.uid && nd().updatedAt == request.time; }
        function nextV() { return nd().v == od().v + 1; }
        function changed() { return nd().diff(od()).affectedKeys(); }
        function lines() { return nd().items is list && nd().items.size() > 0 && nd().items.size() <= 200; }
        function auditPath(a) { return /databases/$(database)/documents/tenants/$(t)/invoiceAudit/$(a); }
        function invAudit(action) {
          return nd().lastAuditId is string && !exists(auditPath(nd().lastAuditId)) && existsAfter(auditPath(nd().lastAuditId))
            && getAfter(auditPath(nd().lastAuditId)).data.action == action
            && getAfter(auditPath(nd().lastAuditId)).data.invoiceId == id
            && getAfter(auditPath(nd().lastAuditId)).data.actorUid == request.auth.uid;
        }
        function noPath(no) { return /databases/$(database)/documents/tenants/$(t)/invoiceNos/$(no); }
        function newNumber() { return nd().no is string && nd().no.size() <= 40 && !exists(noPath(nd().no)) && existsAfter(noPath(nd().no)); }

        allow read: if hasArea(t, 'finance') && canRead(t);
        // A new draft (a duplicate is audited), an invoice issued at delivery (sent, perhaps with cash collected;
        // audited as sent), or a note issued final.
        allow create: if nd().v == 1 && nd().createdBy == request.auth.uid && stamped() && newNumber() && lines() && finOk()
          && ((nd().get('type', 'invoice') == 'invoice' && nd().status == 'Draft' && (!('duplicatedFrom' in nd()) || invAudit('duplicate')))
            || (nd().get('type', 'invoice') == 'invoice' && nd().status in ['Sent', 'Partially paid', 'Paid']
              && nd().sentBy == request.auth.uid && nd().sentAt == request.time && invAudit('send'))
            || (nd().get('type', 'invoice') in ['credit', 'debit', 'refund'] && nd().status == 'Issued' && invAudit('issue')));
        // Saving a draft.
        function saveDraft() {
          return od().status == 'Draft' && nd().status == 'Draft' && lines()
            && !changed().hasAny(['no', 'type', 'createdBy', 'createdAt', 'sentAt', 'sentBy', 'payments', 'paidOn', 'voidReason', 'voidedAt', 'voidedBy']);
        }
        // Mark as sent.
        function markSent() {
          return od().status == 'Draft' && nd().status == 'Sent'
            && changed().hasOnly(['status', 'sentAt', 'sentBy', 'v', 'updatedAt', 'updatedBy', 'lastAuditId'])
            && nd().sentBy == request.auth.uid && nd().sentAt == request.time && invAudit('send');
        }
        // After sending: payments, note effects, e-Invoice status. A status change (part paid, paid) is audited.
        function afterSent() {
          return od().status in ['Sent', 'Partially paid', 'Paid'] && nd().status in ['Sent', 'Partially paid', 'Paid']
            && changed().hasOnly(['status', 'payments', 'paidOn', 'adjust', 'refunded', 'einvoice', 'v', 'updatedAt', 'updatedBy', 'lastAuditId'])
            && (nd().status == od().status || invAudit('pay'));
        }
        // Void, with a reason.
        function voided() {
          return od().status in ['Sent', 'Partially paid'] && nd().status == 'Void' && od().get('payments', []).size() == 0
            && changed().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedBy', 'v', 'updatedAt', 'updatedBy', 'lastAuditId'])
            && shortText(nd().voidReason, 300) && nd().voidReason.size() >= 3
            && nd().voidedBy == request.auth.uid && nd().voidedAt == request.time && invAudit('void');
        }
        // A note's e-Invoice status.
        function noteStatus() { return od().get('type', 'invoice') != 'invoice' && changed().hasOnly(['einvoice', 'v', 'updatedAt', 'updatedBy']); }
        // One rule, so the company and access checks run once (rules may evaluate at most 1,000 expressions).
        allow update: if nextV() && stamped() && (saveDraft() || markSent() || afterSent() || voided() || noteStatus()) && finOk();
        allow delete: if od().status == 'Draft' && finOk();
      }
      // Who did what to which invoice, and when. Added only; never changed or removed.
      match /invoiceAudit/{a} {
        allow read: if hasArea(t, 'finance') && canRead(t);
        allow create: if hasArea(t, 'finance') && working(t) && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time && request.resource.data.invoiceId is string
          && request.resource.data.action in ['send', 'void', 'pay', 'duplicate', 'issue', 'delete'];
      }
      // Each invoice number, held by its invoice. Freed only when its draft is deleted in the same batch.
      match /invoiceNos/{no} {
        allow read: if hasArea(t, 'finance') && canRead(t);
        allow create: if hasArea(t, 'finance') && working(t) && request.resource.data.invoiceId is string
          && getAfter(/databases/$(database)/documents/tenants/$(t)/invoices/$(request.resource.data.invoiceId)).data.no == no;
        allow delete: if hasArea(t, 'finance') && working(t)
          && !existsAfter(/databases/$(database)/documents/tenants/$(t)/invoices/$(resource.data.invoiceId));
      }
      match /people/{e} {
        allow read: if (seesPeople(t) || (member(t) && me().empId == e)) && canRead(t);
        allow create, delete: if seesPeople(t) && working(t);
        allow update: if (seesPeople(t) || (member(t) && me().empId == e
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices', 'face']))) && working(t);
      }
      match /payslips/{e} {
        allow read: if (hasArea(t, 'payroll') || (member(t) && me().empId == e)) && canRead(t);
        allow write: if hasArea(t, 'payroll') && working(t);
      }
      match /personal/{e} {
        allow read: if member(t) && me().empId == e && canRead(t);
        allow write: if member(t) && me().empId == e && working(t);
      }
      // ---- Point of sale (js/pos.js, functions/pos) ----
      // Everyone on the till reads the outlet, menu, tables and today's orders. Money is written only by Cloud
      // Functions (Admin SDK, which skips these rules): payments, refunds, receipt numbers, paid/void status, shift
      // close and the audit log. So a browser can never mark a payment approved, change a paid order or rewrite
      // what the drawer should hold. Nothing is deleted. All of it stops when the company isn't working(t).
      function posRole() { return me().get('posRole', admin(t) && (owner() || 'pos' in me().perms) ? 'manager' : ''); }
      function onTill(roles) { return member(t) && posRole() in roles; }
      function posStaff() { return onTill(['manager', 'cashier', 'waiter', 'kitchen']); }
      // Fields of an order that only the server sets.
      function serverOrderFields() { return ['status', 'paidAt', 'receiptNo', 'rounding', 'voidedAt', 'voidedBy', 'voidReason', 'refunded']; }
      match /pos_outlets/{id} {
        allow read: if posStaff() && canRead(t);
        allow write: if onTill(['manager']) && working(t);
      }
      match /pos_menu/{id} {
        allow read: if posStaff() && canRead(t);
        allow write: if onTill(['manager']) && working(t);
      }
      match /pos_tables/{id} {
        allow read: if posStaff() && canRead(t);
        allow create, delete: if false;
        allow update: if (onTill(['manager']) || (onTill(['cashier', 'waiter'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentOrderId']))) && working(t);
      }
      match /pos_orders/{id} {
        allow read: if posStaff() && canRead(t);
        // The document id is the order's clientOrderId, so an order synced twice from the offline queue is one order.
        allow create: if onTill(['manager', 'cashier', 'waiter']) && working(t) && id == request.resource.data.clientOrderId
          && request.resource.data.status in ['open', 'sent'] && request.resource.data.createdBy == me().empId
          && !request.resource.data.keys().hasAny(['paidAt', 'receiptNo', 'voidedAt', 'refunded']);
        allow update: if working(t) && resource.data.status in ['open', 'sent']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOrderFields().removeAll(['status']))
          && request.resource.data.status in ['open', 'sent']
          && (onTill(['manager', 'cashier', 'waiter'])
            // The kitchen only moves lines along (new → preparing → ready → served).
            || (onTill(['kitchen']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines'])));
        allow delete: if false;
      }
      // Written only by Cloud Functions: recordPayment (cash and recorded card/QR), createQrPayment and the gateway
      // webhook (phase 2), the SoftPOS confirmation (phase 3), refunds, shift close and the daily Finance posting.
      match /pos_payments/{id} { allow read: if onTill(['manager', 'cashier']) && canRead(t); allow write: if false; }
      match /pos_refunds/{id} { allow read: if onTill(['manager']) && canRead(t); allow write: if false; }
      match /pos_shifts/{id} { allow read: if onTill(['manager', 'cashier']) && canRead(t); allow write: if false; }
      match /pos_counters/{id} { allow read, write: if false; }
      match /pos_audit/{id} { allow read: if onTill(['manager']) && canRead(t); allow write: if false; }

      match /blobs/{id} {
        allow read: if member(t) && canRead(t);
        allow create: if member(t) && request.resource.data.d is string && request.resource.data.d.size() < 1048000 && working(t);
        allow delete: if admin(t) && working(t);
      }
    }
  }
}
