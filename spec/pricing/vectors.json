{
  "spec_version": 1,
  "note": "Golden vectors for spec/pricing/SPEC.md. Expected values are hand-calculated, not generated by an implementation. Tax rates here are test data, not legal rates.",
  "cases": [
    {
      "name": "single_item_card_exempt",
      "input": {
        "tender": "card",
        "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 350, "tax_code": "EXEMPT" }]
      },
      "expected": {
        "lines": [{ "id": "L1", "gross_sen": 350, "line_discount_sen": 0, "order_discount_sen": 0, "net_sen": 350 }],
        "subtotal_sen": 350, "discount_sen": 0, "service_charge_sen": 0,
        "tax_breakdown": [{ "code": "EXEMPT", "rate_bps": 0, "rule_version": 1, "base_sen": 350, "amount_sen": 0 }],
        "tax_sen": 0, "rounding_sen": 0, "total_sen": 350
      }
    },
    {
      "name": "cash_rounds_down",
      "why": "700 + 6% = 742; last digit 2 rounds down to 740",
      "input": {
        "tender": "cash",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 2000, "unit_price_sen": 350, "tax_code": "SST_SERVICE" }]
      },
      "expected": {
        "subtotal_sen": 700, "discount_sen": 0, "service_charge_sen": 0,
        "tax_breakdown": [{ "code": "SST_SERVICE", "rate_bps": 600, "rule_version": 1, "base_sen": 700, "amount_sen": 42 }],
        "tax_sen": 42, "rounding_sen": -2, "total_sen": 740
      }
    },
    {
      "name": "cash_rounds_up",
      "why": "1240 x 6% = 74.4 -> 74; 1314 ends in 4, rounds up to 1315",
      "input": {
        "tender": "cash",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 1240, "tax_code": "SST_SERVICE" }]
      },
      "expected": { "subtotal_sen": 1240, "tax_sen": 74, "rounding_sen": 1, "total_sen": 1315 }
    },
    {
      "name": "card_is_not_rounded",
      "why": "same basket as cash_rounds_up, paid by card",
      "input": {
        "tender": "card",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 1240, "tax_code": "SST_SERVICE" }]
      },
      "expected": { "subtotal_sen": 1240, "tax_sen": 74, "rounding_sen": 0, "total_sen": 1314 }
    },
    {
      "name": "fractional_qty_half_up",
      "why": "0.375 kg x 2990 = 1121.25 -> 1121; 1.5 x 333 = 499.5 -> 500",
      "input": {
        "tender": "card",
        "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [
          { "id": "L1", "qty_milli": 375, "unit_price_sen": 2990, "tax_code": "EXEMPT" },
          { "id": "L2", "qty_milli": 1500, "unit_price_sen": 333, "tax_code": "EXEMPT" }
        ]
      },
      "expected": {
        "lines": [
          { "id": "L1", "gross_sen": 1121, "line_discount_sen": 0, "order_discount_sen": 0, "net_sen": 1121 },
          { "id": "L2", "gross_sen": 500, "line_discount_sen": 0, "order_discount_sen": 0, "net_sen": 500 }
        ],
        "subtotal_sen": 1621, "total_sen": 1621
      }
    },
    {
      "name": "modifiers_are_per_unit",
      "why": "(450 + 150 + 100) x 2",
      "input": {
        "tender": "card",
        "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [{
          "id": "L1", "qty_milli": 2000, "unit_price_sen": 450, "tax_code": "EXEMPT",
          "modifiers": [{ "name": "Extra shot", "price_delta_sen": 150 }, { "name": "Oat milk", "price_delta_sen": 100 }]
        }]
      },
      "expected": { "subtotal_sen": 1400, "total_sen": 1400 }
    },
    {
      "name": "line_percent_discount_then_tax",
      "why": "1999 x 15% = 299.85 -> 300; tax on 1699 x 6% = 101.94 -> 102",
      "input": {
        "tender": "card",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 1999, "tax_code": "SST_SERVICE", "discount": { "percent_bps": 1500 } }]
      },
      "expected": {
        "lines": [{ "id": "L1", "gross_sen": 1999, "line_discount_sen": 300, "order_discount_sen": 0, "net_sen": 1699 }],
        "subtotal_sen": 1999, "discount_sen": 300,
        "tax_breakdown": [{ "code": "SST_SERVICE", "rate_bps": 600, "rule_version": 1, "base_sen": 1699, "amount_sen": 102 }],
        "tax_sen": 102, "total_sen": 1801
      }
    },
    {
      "name": "order_amount_discount_largest_remainder",
      "why": "100 sen over three equal lines: 33.33 each; the leftover sen goes to the first line, which is the taxed one",
      "input": {
        "tender": "card",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 }, "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [
          { "id": "L1", "qty_milli": 1000, "unit_price_sen": 1000, "tax_code": "SST_SERVICE" },
          { "id": "L2", "qty_milli": 1000, "unit_price_sen": 1000, "tax_code": "EXEMPT" },
          { "id": "L3", "qty_milli": 1000, "unit_price_sen": 1000, "tax_code": "EXEMPT" }
        ],
        "order_discount": { "amount_sen": 100 }
      },
      "expected": {
        "lines": [
          { "id": "L1", "gross_sen": 1000, "line_discount_sen": 0, "order_discount_sen": 34, "net_sen": 966 },
          { "id": "L2", "gross_sen": 1000, "line_discount_sen": 0, "order_discount_sen": 33, "net_sen": 967 },
          { "id": "L3", "gross_sen": 1000, "line_discount_sen": 0, "order_discount_sen": 33, "net_sen": 967 }
        ],
        "subtotal_sen": 3000, "discount_sen": 100,
        "tax_breakdown": [
          { "code": "EXEMPT", "rate_bps": 0, "rule_version": 1, "base_sen": 1934, "amount_sen": 0 },
          { "code": "SST_SERVICE", "rate_bps": 600, "rule_version": 1, "base_sen": 966, "amount_sen": 58 }
        ],
        "tax_sen": 58, "rounding_sen": 0, "total_sen": 2958
      }
    },
    {
      "name": "mixed_tax_codes_order_percent_cash",
      "why": "10% off 2300 = 230 split 100/100/30; sales tax 10% on 900, service tax 8% on 900; 2232 cash -> 2230",
      "input": {
        "tender": "cash",
        "tax_rules": {
          "SST_SALES": { "rate_bps": 1000, "version": 1 },
          "SST_SERVICE": { "rate_bps": 800, "version": 1 },
          "EXEMPT": { "rate_bps": 0, "version": 1 }
        },
        "lines": [
          { "id": "X", "qty_milli": 1000, "unit_price_sen": 1000, "tax_code": "SST_SALES" },
          { "id": "Y", "qty_milli": 2000, "unit_price_sen": 500, "tax_code": "SST_SERVICE" },
          { "id": "Z", "qty_milli": 1000, "unit_price_sen": 300, "tax_code": "EXEMPT" }
        ],
        "order_discount": { "percent_bps": 1000 }
      },
      "expected": {
        "lines": [
          { "id": "X", "gross_sen": 1000, "line_discount_sen": 0, "order_discount_sen": 100, "net_sen": 900 },
          { "id": "Y", "gross_sen": 1000, "line_discount_sen": 0, "order_discount_sen": 100, "net_sen": 900 },
          { "id": "Z", "gross_sen": 300, "line_discount_sen": 0, "order_discount_sen": 30, "net_sen": 270 }
        ],
        "subtotal_sen": 2300, "discount_sen": 230, "service_charge_sen": 0,
        "tax_breakdown": [
          { "code": "EXEMPT", "rate_bps": 0, "rule_version": 1, "base_sen": 270, "amount_sen": 0 },
          { "code": "SST_SALES", "rate_bps": 1000, "rule_version": 1, "base_sen": 900, "amount_sen": 90 },
          { "code": "SST_SERVICE", "rate_bps": 800, "rule_version": 1, "base_sen": 900, "amount_sen": 72 }
        ],
        "tax_sen": 162, "rounding_sen": -2, "total_sen": 2230
      }
    },
    {
      "name": "service_charge_is_taxed",
      "why": "F&B: 10% service charge on 2500 = 250, then service tax on 2750 = 220; rule_version carried through",
      "input": {
        "tender": "cash",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 800, "version": 3 } },
        "lines": [
          { "id": "A", "qty_milli": 1000, "unit_price_sen": 1200, "tax_code": "SST_SERVICE" },
          { "id": "B", "qty_milli": 2000, "unit_price_sen": 650, "tax_code": "SST_SERVICE" }
        ],
        "service_charge": { "rate_bps": 1000, "tax_code": "SST_SERVICE" }
      },
      "expected": {
        "subtotal_sen": 2500, "discount_sen": 0, "service_charge_sen": 250,
        "tax_breakdown": [{ "code": "SST_SERVICE", "rate_bps": 800, "rule_version": 3, "base_sen": 2750, "amount_sen": 220 }],
        "tax_sen": 220, "rounding_sen": 0, "total_sen": 2970
      }
    },
    {
      "name": "service_charge_untaxed_after_order_discount",
      "why": "non-registered outlet: 3000 - 500 = 2500, service charge 250 untaxed and not in the breakdown",
      "input": {
        "tender": "cash",
        "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 2000, "unit_price_sen": 1500, "tax_code": "EXEMPT" }],
        "order_discount": { "amount_sen": 500 },
        "service_charge": { "rate_bps": 1000, "tax_code": null }
      },
      "expected": {
        "lines": [{ "id": "L1", "gross_sen": 3000, "line_discount_sen": 0, "order_discount_sen": 500, "net_sen": 2500 }],
        "subtotal_sen": 3000, "discount_sen": 500, "service_charge_sen": 250,
        "tax_breakdown": [{ "code": "EXEMPT", "rate_bps": 0, "rule_version": 1, "base_sen": 2500, "amount_sen": 0 }],
        "tax_sen": 0, "rounding_sen": 0, "total_sen": 2750
      }
    },
    {
      "name": "line_amount_discount_clamped_to_gross",
      "why": "RM8 off a RM5 line takes it to zero, never negative; a code with zero base still appears",
      "input": {
        "tender": "card",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 }, "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [
          { "id": "L1", "qty_milli": 1000, "unit_price_sen": 500, "tax_code": "SST_SERVICE", "discount": { "amount_sen": 800 } },
          { "id": "L2", "qty_milli": 1000, "unit_price_sen": 300, "tax_code": "EXEMPT" }
        ]
      },
      "expected": {
        "lines": [
          { "id": "L1", "gross_sen": 500, "line_discount_sen": 500, "order_discount_sen": 0, "net_sen": 0 },
          { "id": "L2", "gross_sen": 300, "line_discount_sen": 0, "order_discount_sen": 0, "net_sen": 300 }
        ],
        "subtotal_sen": 800, "discount_sen": 500,
        "tax_breakdown": [
          { "code": "EXEMPT", "rate_bps": 0, "rule_version": 1, "base_sen": 300, "amount_sen": 0 },
          { "code": "SST_SERVICE", "rate_bps": 600, "rule_version": 1, "base_sen": 0, "amount_sen": 0 }
        ],
        "tax_sen": 0, "total_sen": 300
      }
    },
    {
      "name": "tax_half_sen_rounds_up",
      "why": "1025 x 6% = 61.5 -> 62",
      "input": {
        "tender": "card",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 1025, "tax_code": "SST_SERVICE" }]
      },
      "expected": { "tax_sen": 62, "total_sen": 1087 }
    },
    {
      "name": "order_percent_remainder_ties_go_to_earlier_lines",
      "why": "33.33% of 609 = 202.98 -> 203; every line has the same remainder, so lines 1 and 2 get the two leftover sen",
      "input": {
        "tender": "card",
        "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [
          { "id": "L1", "qty_milli": 1000, "unit_price_sen": 101, "tax_code": "EXEMPT" },
          { "id": "L2", "qty_milli": 1000, "unit_price_sen": 203, "tax_code": "EXEMPT" },
          { "id": "L3", "qty_milli": 1000, "unit_price_sen": 305, "tax_code": "EXEMPT" }
        ],
        "order_discount": { "percent_bps": 3333 }
      },
      "expected": {
        "lines": [
          { "id": "L1", "gross_sen": 101, "line_discount_sen": 0, "order_discount_sen": 34, "net_sen": 67 },
          { "id": "L2", "gross_sen": 203, "line_discount_sen": 0, "order_discount_sen": 68, "net_sen": 135 },
          { "id": "L3", "gross_sen": 305, "line_discount_sen": 0, "order_discount_sen": 101, "net_sen": 204 }
        ],
        "subtotal_sen": 609, "discount_sen": 203, "total_sen": 406
      }
    },
    {
      "name": "free_item_and_cash_round_down_by_one",
      "why": "3 x 233 = 699, tax 41.94 -> 42, 741 cash -> 740",
      "input": {
        "tender": "cash",
        "tax_rules": { "SST_SERVICE": { "rate_bps": 600, "version": 1 }, "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [
          { "id": "W", "qty_milli": 1000, "unit_price_sen": 0, "tax_code": "EXEMPT" },
          { "id": "L2", "qty_milli": 3000, "unit_price_sen": 233, "tax_code": "SST_SERVICE" }
        ]
      },
      "expected": { "subtotal_sen": 699, "tax_sen": 42, "rounding_sen": -1, "total_sen": 740 }
    },

    { "name": "error_no_lines", "input": { "tender": "cash", "tax_rules": {}, "lines": [] }, "expected_error": "no_lines" },
    {
      "name": "error_zero_qty",
      "input": { "tender": "cash", "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 0, "unit_price_sen": 100, "tax_code": "EXEMPT" }] },
      "expected_error": "invalid_qty"
    },
    {
      "name": "error_unknown_tax_code",
      "input": { "tender": "cash", "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 100, "tax_code": "GST" }] },
      "expected_error": "unknown_tax_code"
    },
    {
      "name": "error_negative_unit_price",
      "input": { "tender": "cash", "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 100, "tax_code": "EXEMPT", "modifiers": [{ "price_delta_sen": -150 }] }] },
      "expected_error": "negative_unit_price"
    },
    {
      "name": "error_discount_over_100_percent",
      "input": { "tender": "cash", "tax_rules": { "EXEMPT": { "rate_bps": 0, "version": 1 } },
        "lines": [{ "id": "L1", "qty_milli": 1000, "unit_price_sen": 100, "tax_code": "EXEMPT", "discount": { "percent_bps": 12000 } }] },
      "expected_error": "invalid_discount"
    }
  ]
}
