{
  "spec_version": 1,
  "note": "Golden vectors for spec/time-billing/SPEC.md. Hand-calculated.",
  "cases": [
    { "name": "under_minimum_charges_minimum", "why": "10 min -> 30 min minimum -> 1500 x 30/60",
      "input": { "rate": { "rate_sen": 1500, "unit_minutes": 60, "min_minutes": 30, "round_to": 15, "round": "up" }, "elapsed_seconds": 600, "paused_seconds": 0 },
      "expected": { "billable_seconds": 600, "billed_minutes": 30, "amount_sen": 750 } },
    { "name": "rounds_up_to_quarter_hour", "why": "47 min -> 60",
      "input": { "rate": { "rate_sen": 1500, "unit_minutes": 60, "min_minutes": 30, "round_to": 15, "round": "up" }, "elapsed_seconds": 2820, "paused_seconds": 0 },
      "expected": { "billable_seconds": 2820, "billed_minutes": 60, "amount_sen": 1500 } },
    { "name": "one_second_over_starts_a_minute", "why": "61:01 -> 62 min -> 75",
      "input": { "rate": { "rate_sen": 1500, "unit_minutes": 60, "min_minutes": 30, "round_to": 15, "round": "up" }, "elapsed_seconds": 3661, "paused_seconds": 0 },
      "expected": { "billable_seconds": 3661, "billed_minutes": 75, "amount_sen": 1875 } },
    { "name": "pause_is_not_billed", "why": "90 min with 30 paused -> 60",
      "input": { "rate": { "rate_sen": 1500, "unit_minutes": 60, "min_minutes": 30, "round_to": 15, "round": "up" }, "elapsed_seconds": 5400, "paused_seconds": 1800 },
      "expected": { "billable_seconds": 3600, "billed_minutes": 60, "amount_sen": 1500 } },
    { "name": "exact_boundary_stays", "why": "45:00 exactly is 45 min",
      "input": { "rate": { "rate_sen": 1500, "unit_minutes": 60, "min_minutes": 30, "round_to": 15, "round": "up" }, "elapsed_seconds": 2700, "paused_seconds": 0 },
      "expected": { "billed_minutes": 45, "amount_sen": 1125 } },
    { "name": "one_second_past_boundary_rounds_up", "why": "45:01 -> 46 -> 60",
      "input": { "rate": { "rate_sen": 1500, "unit_minutes": 60, "min_minutes": 30, "round_to": 15, "round": "up" }, "elapsed_seconds": 2701, "paused_seconds": 0 },
      "expected": { "billed_minutes": 60, "amount_sen": 1500 } },
    { "name": "per_minute_half_sen_rounds_up", "why": "7 min at RM10/h = 116.67 -> 117",
      "input": { "rate": { "rate_sen": 1000, "unit_minutes": 60, "min_minutes": 0, "round_to": 1, "round": "up" }, "elapsed_seconds": 420, "paused_seconds": 0 },
      "expected": { "billed_minutes": 7, "amount_sen": 117 } },
    { "name": "zero_without_minimum", "input": { "rate": { "rate_sen": 1000, "unit_minutes": 60, "min_minutes": 0, "round_to": 1, "round": "up" }, "elapsed_seconds": 0, "paused_seconds": 0 },
      "expected": { "billable_seconds": 0, "billed_minutes": 0, "amount_sen": 0 } },
    { "name": "round_down_to_half_hour", "why": "59 min -> 30",
      "input": { "rate": { "rate_sen": 1200, "unit_minutes": 60, "min_minutes": 0, "round_to": 30, "round": "down" }, "elapsed_seconds": 3540, "paused_seconds": 0 },
      "expected": { "billed_minutes": 30, "amount_sen": 600 } },
    { "name": "round_down_partial_minute_counts_first", "why": "89:30 -> 90 min, already on a half hour",
      "input": { "rate": { "rate_sen": 1200, "unit_minutes": 60, "min_minutes": 0, "round_to": 30, "round": "down" }, "elapsed_seconds": 5370, "paused_seconds": 0 },
      "expected": { "billed_minutes": 90, "amount_sen": 1800 } },
    { "name": "per_minute_rate", "why": "karaoke 50 sen/min, 125:30 -> 126 min",
      "input": { "rate": { "rate_sen": 50, "unit_minutes": 1, "min_minutes": 60, "round_to": 1, "round": "up" }, "elapsed_seconds": 7530, "paused_seconds": 0 },
      "expected": { "billed_minutes": 126, "amount_sen": 6300 } },

    { "name": "error_negative_elapsed", "input": { "rate": { "rate_sen": 1000, "unit_minutes": 60, "min_minutes": 0, "round_to": 1, "round": "up" }, "elapsed_seconds": -1, "paused_seconds": 0 }, "expected_error": "invalid_duration" },
    { "name": "error_pause_longer_than_session", "input": { "rate": { "rate_sen": 1000, "unit_minutes": 60, "min_minutes": 0, "round_to": 1, "round": "up" }, "elapsed_seconds": 600, "paused_seconds": 900 }, "expected_error": "invalid_duration" },
    { "name": "error_zero_unit", "input": { "rate": { "rate_sen": 1000, "unit_minutes": 0, "min_minutes": 0, "round_to": 1, "round": "up" }, "elapsed_seconds": 600, "paused_seconds": 0 }, "expected_error": "invalid_rate" },
    { "name": "error_unknown_rounding", "input": { "rate": { "rate_sen": 1000, "unit_minutes": 60, "min_minutes": 0, "round_to": 1, "round": "nearest" }, "elapsed_seconds": 600, "paused_seconds": 0 }, "expected_error": "invalid_rate" }
  ]
}
