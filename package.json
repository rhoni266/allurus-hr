{
  "name": "allurus-hr",
  "private": true,
  "description": "Allurus HR and the allurus.my site. No build step; open index.html (landing) or app.html (the app).",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-allurus \"node --test tests-rules/*.test.js\"",
    "seed": "node scripts/seed.js",
    "set-superadmin": "node scripts/set-superadmin.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
